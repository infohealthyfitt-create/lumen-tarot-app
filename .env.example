# ============================================================
# SITE
# ============================================================
# Canonical URL used for OG tags, auth redirects, Stripe success/cancel URLs.
# localhost in dev, Netlify preview URL in previews, real domain in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# SUPABASE
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER exposed to the client. Used only in API routes / server components.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# STRIPE (leave disabled until credentials + merchant approval exist)
# ============================================================
ENABLE_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ============================================================
# AI READINGS (optional, off by default — template engine is used instead)
# ============================================================
ENABLE_AI_READINGS=false
AI_API_KEY=
AI_API_BASE_URL=

# ============================================================
# ANALYTICS (optional, vendor-agnostic helper reads these)
# ============================================================
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_ANALYTICS_WRITE_KEY=
